# tzlth-finance 環境變數範本
#
# 用法：複製為 .env.local（本機開發）或逐一填入 Vercel 專案的 Environment Variables。
# ⛔ 本 repo 為 public —— 本檔只記變數名與用途，永遠不填實際值。
# 來源：2026-09-16 由 grep -rn "process.env.[A-Z_]*" app lib middleware.ts next.config.ts 機器產出。

# ── 必填 ────────────────────────────────────────────────

# 登入密碼（4-8 位），同時作為 HMAC-SHA256 token 的簽章金鑰
# 讀取位置：lib/auth.ts（verifyPin / generateToken / verifyToken）
# 未設定：完全無法登入
ACCESS_PIN=

# GitHub PAT，用於讀寫資料 repo 的 JSON（本系統以 GitHub 當資料庫）
# 讀取位置：lib/github.ts
# 未設定：所有資料讀寫失敗
GITHUB_TOKEN=

# 守住 /api/summary 的 Bearer key
# 讀取位置：app/api/summary/route.ts
# ⛔ 必須與 HQ 儀表板 Vercel 的 FINANCE_SUMMARY_API_KEY 同值
# 未設定：端點永遠回 401 ⇒ 儀表板財務卡空白
SUMMARY_API_KEY=

# ── 選填（有預設值）──────────────────────────────────────

# 資料存放的 repo，預設 shoppy09/tzlth-hq
# 讀取位置：lib/github.ts
DATA_REPO=

# ── 平台注入（不需手動設定）──────────────────────────────
# NODE_ENV  — Vercel 自動注入；用於決定 cookie 的 secure 旗標
